msgid "© 2026 Northern Lights Brewing Co. All rights reserved. Brewed above the 66th parallel."
msgstr ""

#: src/App.jsx:62
msgid "4.8% ABV"
msgstr ""

#: src/App.jsx:87
msgid "500 litres at a time. Every batch is numbered and dated. When it's gone, it's gone. We'd rather make something perfect than something scalable. The world is big enough to appreciate small things."
msgstr ""

#: src/App.jsx:68
msgid "6.5% ABV"
msgstr ""

#: src/App.jsx:56
