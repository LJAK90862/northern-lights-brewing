msgstr ""

#: src/App.jsx:24
msgid "Beer that speaks every language."
msgstr ""

#: src/App.jsx:67
msgid "Birchwood Stout"
msgstr ""

#: src/App.jsx:100
msgid "Borders are for maps, not for beer."
msgstr ""

#: src/App.jsx:86
msgid "Brew small"
msgstr ""

#: src/App.jsx:63
msgid "Brewed during the three months when the sun never sets. Crisp, clean, and cold enough to cut through a summer night that never gets dark. The locals call it \"the one that crosses every border without stopping.\""
msgstr ""

